# ==============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Your application's public URL (required for Stripe redirects)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# STRIPE PAYMENT CONFIGURATION
# ==============================================

# Get your keys from: https://dashboard.stripe.com/apikeys
# 
# TEST MODE (for development):
# - Use keys that start with sk_test_ and pk_test_
# 
# LIVE MODE (for production):
# - Use keys that start with sk_live_ and pk_live_
# - NEVER commit live keys to Git!

# Stripe Secret Key (Server-side only)
# Test: sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live: sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_ACTUAL_TEST_KEY

# Stripe Publishable Key (Client-side safe)
# Test: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live: pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_ACTUAL_PUBLISHABLE_KEY

# Stripe Webhook Secret (for webhook signature verification)
# Get from: https://dashboard.stripe.com/webhooks
# Create endpoint: https://yourdomain.com/api/webhooks/stripe
# Test: whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live: whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_ACTUAL_WEBHOOK_SECRET

# ==============================================
# EMAIL CONFIGURATION (RESEND)
# ==============================================

# Get your API key from: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_your_resend_api_key_here

# Business email address (receives booking notifications)
BUSINESS_EMAIL=your-business-email@example.com

# ==============================================
# OPTIONAL: PERSISTENT STORAGE
# ==============================================

# If using Vercel KV (auto-configured by Vercel)
# KV_REST_API_URL=https://xxx.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxxxx

# If using Upstash Redis
# Get from: https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx

# ==============================================
# NOTES
# ==============================================
# 
# 1. After copying to .env.local, replace all placeholder values
# 2. Restart your dev server after changing environment variables
# 3. For production, set these in your hosting platform's environment variables
# 4. Test mode keys are safe for development, but switch to live keys for production
# 5. Webhook secret is REQUIRED in production for security
